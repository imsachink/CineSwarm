{
  "name": "cineswarm",
  "version": "1.0.0",
  "description": "CineSwarm - High-Speed Web & P2P Swarm Media Player",
  "main": "main.js",
  "scripts": {
    "start": "node launch.js",
    "dist": "electron-builder"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "webtorrent": "^3.0.21"
  },
  "devDependencies": {
    "electron": "^33.2.1"
  },
  "build": {
    "appId": "com.cineswarm.player",
    "productName": "CineSwarm",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!CineSwarm.app/**",
      "!CineSwarm.command",
      "!TorrentStream.app/**",
      "!TorrentStream.command"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "CineSwarm.icns",
      "category": "public.app-category.video"
    }
  }
}
